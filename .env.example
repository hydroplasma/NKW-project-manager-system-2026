# SQLite for local development. Kept separate from DATABASE_URL because the managed WebDev
# database injects a MySQL DATABASE_URL while this starter intentionally uses SQLite.
SQLITE_DATABASE_URL="file:../dev.db"

# NextAuth/Manus OAuth; never commit the real values.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-long-random-value-for-local-development"
MANUS_PROJECT_ID=""
MANUS_OAUTH_PORTAL_URL=""
MANUS_OAUTH_API_URL=""
INITIAL_ADMIN_OPEN_ID=""
